{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AiGanak/llm-prices/schema/prices.schema.json",
  "title": "LLM API prices",
  "description": "List prices for large language model APIs, in USD per million tokens.",
  "type": "object",
  "required": ["schema_version", "dataset", "publisher", "license", "currency", "unit", "checked", "models"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "dataset": { "const": "llm-api-prices" },
    "publisher": {
      "type": "object", "required": ["name", "url"],
      "properties": { "name": { "type": "string" }, "url": { "type": "string", "format": "uri" } }
    },
    "license": { "const": "CC-BY-4.0" },
    "currency": { "const": "USD" },
    "unit": { "const": "per_million_tokens" },
    "modality": { "const": "text" },
    "tier_basis": { "type": "string" },
    "checked": { "$ref": "#/$defs/date" },
    "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } }
  },
  "additionalProperties": false,
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "usd": { "type": "number", "minimum": 0 },
    "rates": {
      "type": "object", "required": ["input", "cached_input", "output"],
      "properties": {
        "input": { "$ref": "#/$defs/usd", "description": "Uncached input (prompt) tokens." },
        "cached_input": { "$ref": "#/$defs/usd", "description": "Input tokens read from the provider's prompt cache." },
        "output": { "$ref": "#/$defs/usd", "description": "Output (completion) tokens, including reasoning tokens where billed." }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["id", "provider", "name", "tier", "status", "pricing", "scheduled_changes", "source_url", "checked"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$", "description": "The provider's API model ID." },
        "provider": { "enum": ["OpenAI", "Anthropic", "Google"] },
        "name": { "type": "string" },
        "tier": { "enum": ["flagship", "mid", "small"] },
        "status": { "enum": ["active", "preview", "legacy"] },
        "pricing": {
          "type": "object", "required": ["standard", "batch"],
          "properties": {
            "standard": { "$ref": "#/$defs/rates" },
            "batch": { "$ref": "#/$defs/rates", "description": "Asynchronous batch processing price." },
            "cache_write": { "$ref": "#/$defs/usd", "description": "Price to write input tokens to the shortest-lived prompt cache." },
            "long_context": {
              "type": "object", "required": ["threshold_tokens", "standard"],
              "description": "Rates that apply to the whole request when the prompt is longer than threshold_tokens.",
              "properties": {
                "threshold_tokens": { "type": "integer", "minimum": 1 },
                "standard": { "$ref": "#/$defs/rates" },
                "note": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "scheduled_changes": {
          "type": "array",
          "description": "Announced future prices, applying from the effective date.",
          "items": {
            "type": "object", "required": ["effective", "standard"],
            "properties": { "effective": { "$ref": "#/$defs/date" }, "standard": { "$ref": "#/$defs/rates" }, "batch": { "$ref": "#/$defs/rates" } },
            "additionalProperties": false
          }
        },
        "source_url": { "type": "string", "format": "uri", "description": "The provider page the prices were copied from." },
        "reference_url": { "type": "string", "format": "uri" },
        "checked": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": false
    }
  }
}
