{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AiGanak/llm-prices/schema/changes.schema.json",
  "title": "LLM API price change log",
  "type": "object",
  "required": ["schema_version", "changes"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "provider", "type", "title", "detail", "source_url"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "When the change was announced or published." },
          "effective": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "When the new price applies, if later." },
          "provider": { "enum": ["OpenAI", "Anthropic", "Google"] },
          "type": { "enum": ["price_increase", "price_cut", "new_model", "new_pricing_option", "credits", "deprecation"] },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
